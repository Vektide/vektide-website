---
// About: who we are, where the name comes from, how we started, what we believe, who you'll
// talk to, and the company on paper. Copy: docs/website-copy.md, "About".
// The one big moment is the name (AboutName); everything else stays quiet around it.
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import AboutName from '../components/about/AboutName.astro';
import Footer from '../components/Footer.astro';
import { address, hours, mapsUrl } from '../data/contact';
import { founders, legalName, registeredIn } from '../data/company';

const beliefs: [string, string][] = [
  ['Workflow before code', 'We sit with your team and learn the work before we write a line of code. The best software follows how people already work.'],
  ['Simple beats clever', 'If your staff need a manual, we built it wrong. Every screen should be obvious to the person using it.'],
  ['We stay after launch', 'Hosting, updates, backups and support are part of the job, not an extra. When something comes up, you call the people who built it.'],
  ['Built here, for here', 'Nepali dates, rupees and the way businesses here really run are built in from the start, not bolted on later.'],
];

const details: [string, string][] = [
  ['Company', legalName],
  ['Registered in', registeredIn],
  ['Hours', `${hours.text}, Nepal time`],
];

const h2 = 'text-4xl leading-[0.95] font-bold tracking-tighter sm:text-6xl';
const label = 'text-[15px] text-soft';
const arrowRight = `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<Base
  title="About Vektide Technologies"
  description="A Lalitpur software company taking the manual work out of Nepali businesses, starting with healthcare."
>
  <Navbar />
  <main>
    <section class="mx-auto max-w-[1280px] px-4 pt-36 sm:px-8 md:pt-48">
      <h1 data-about-in class="text-5xl leading-[0.95] font-bold tracking-tighter in-[.js]:opacity-0 sm:text-7xl lg:text-8xl">
        Moving forward<br />with precision.
      </h1>
      <p data-about-in class="mt-6 max-w-lg text-lg text-soft in-[.js]:opacity-0 sm:text-xl">
        Vektide Technologies is a software company in Lalitpur with a simple mission: take the manual work out of Nepali businesses.
      </p>
    </section>

    <AboutName />

    <!-- Our story -->
    <section class="mx-auto grid max-w-[1280px] gap-10 px-4 py-24 sm:px-8 md:grid-cols-[1fr_1.4fr] md:gap-20 md:py-36">
      <h2 class={`${h2} md:sticky md:top-32 md:self-start`}>Started inside<br />a polyclinic.</h2>
      <div>
        <div class="max-w-xl space-y-5 text-lg leading-relaxed text-soft sm:text-xl">
          <p>
            Vektide started inside a polyclinic. We watched reception staff juggle paper slips, lab fees go unpaid and owners close the day
            without clear numbers.
          </p>
          <p>
            So we built a system to fix it, sitting with the staff, learning every step and shaping the software around their real work.
            <span class="text-ink">That system became PCMS. The approach became Vektide:</span> understand the workflow first, then build
            software that fits it.
          </p>
        </div>

        <a href="/pcms" class="group/card mt-12 inline-grid grid-cols-[120px_1fr] gap-4 sm:grid-cols-[180px_minmax(0,260px)] sm:gap-6">
          <span class="relative grid aspect-square place-items-center overflow-hidden bg-brand">
            <img
              src="/logo/vektide-mark-white-256.png"
              srcset="/logo/vektide-mark-white-128.png 128w, /logo/vektide-mark-white-256.png 256w"
              sizes="(min-width: 640px) 94px, 62px"
              alt=""
              width="256"
              height="256"
              loading="lazy"
              class="size-[52%] transition-transform duration-600 ease-out-expo group-hover/card:scale-106 group-hover/card:-rotate-4 motion-reduce:transition-none"
            />
            <span class="absolute top-2.5 right-2.5 grid size-9 place-items-center rounded-full bg-white transition-transform duration-350 ease-out-expo group-hover/card:-rotate-45 motion-reduce:transition-none [&_svg]:size-4">
              <Fragment set:html={arrowRight} />
            </span>
          </span>
          <span class="flex flex-col gap-2">
            <span class="text-[15px] font-bold">PCMS</span>
            <span class="text-[15px] leading-snug">The polyclinic system that started it all, now running at Gorkhakali Polyclinic.</span>
            <span class="mt-auto text-sm text-soft underline decoration-line underline-offset-4 transition-colors group-hover/card:text-ink group-hover/card:decoration-ink">Explore PCMS</span>
          </span>
        </a>
      </div>
    </section>

    <!-- What we believe -->
    <section class="mx-auto max-w-[1280px] px-4 pb-24 sm:px-8 md:pb-36">
      <h2 class={h2}>What we believe</h2>
      <ul class="mt-12 grid gap-x-20 md:mt-16 md:grid-cols-2">
        {beliefs.map(([title, body]) => (
          <li class="border-t border-line pt-6 pb-10 md:pb-14">
            <h3 class="text-2xl font-bold tracking-tight sm:text-[28px]">{title}</h3>
            <p class="mt-3 max-w-md text-soft">{body}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Team and company details -->
    <section class="mx-auto grid max-w-[1280px] gap-10 px-4 pb-24 sm:px-8 md:grid-cols-[1fr_1.4fr] md:gap-20 md:pb-36">
      <div class="md:sticky md:top-32 md:self-start">
        <h2 class={h2}>The founders</h2>
        <p class="mt-6 max-w-xs text-soft">Two founders, and no middlemen. You'll talk to us directly, from the first call to support.</p>
      </div>
      <div>
        <ul>
          {founders.map((f) => (
            <li class="border-t border-line py-8">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-4xl font-bold tracking-tighter sm:text-5xl">{f.name}</h3>
                <p class={label}>{f.role}</p>
              </div>
            </li>
          ))}
        </ul>

        <h3 class={`${label} mt-14 md:mt-20`}>Company details</h3>
        <dl class="mt-3">
          {details.map(([term, value]) => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-t border-line py-4">
              <dt class={label}>{term}</dt>
              <dd class="text-lg font-medium">{value}</dd>
            </div>
          ))}
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-y border-line py-4">
            <dt class={label}>Office</dt>
            <dd class="flex flex-wrap items-baseline gap-x-4 text-lg font-medium">
              {address}
              <a href={mapsUrl} target="_blank" rel="noopener" class="text-[15px] font-normal text-soft underline decoration-line underline-offset-4 transition-colors hover:text-ink hover:decoration-ink">Open in Maps</a>
            </dd>
          </div>
        </dl>
      </div>
    </section>
  </main>
  <Footer headline="Let's build something that lasts." />
</Base>

<script>
  import gsap from 'gsap';

  // The heading and intro rise in once.
  const intro = document.querySelectorAll<HTMLElement>('[data-about-in]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) gsap.set(intro, { opacity: 1 });
  else gsap.fromTo(intro, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.08, ease: 'power3.out', delay: 0.1 });
</script>
