---
// PCMS product page. Copy: docs/website-copy.md, "PCMS — Polyclinic Management System".
// Layout modelled on 1centre.com: hero, features with live mockups, modules bento, four dot-matrix
// chapters (Reception, Laboratory, Admin, Hosted), steps, proof, FAQ. Sections alternate white,
// pill grey and navy panels.
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import PcmsHero from '../components/pcms/PcmsHero.astro';
import Features from '../components/pcms/Features.astro';
import Modules from '../components/pcms/Modules.astro';
import Reception from '../components/pcms/Reception.astro';
import Laboratory from '../components/pcms/Laboratory.astro';
import Admin from '../components/pcms/Admin.astro';
import Steps from '../components/pcms/Steps.astro';
import Hosted from '../components/pcms/Hosted.astro';
import Proof from '../components/pcms/Proof.astro';
import FloatingCta from '../components/pcms/FloatingCta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { hours } from '../data/contact';

const title = 'PCMS — Polyclinic Management System | Vektide';
const description =
  "Reception, lab and billing in one system. Track every consultation and lab fee. Your clinic's own private system and database, managed by Vektide.";

const faqs: [string, string][] = [
  ['Do we need our own server?', 'No. We host PCMS for you. Your clinic gets its own private system and database, and we set it up and maintain it.'],
  [
    'Is our data safe?',
    'Yes. Your clinic’s data is kept in its own database, separate from every other clinic, with encrypted backups stored off-site. PCMS has no tracking and sends your patient and financial records nowhere. Your data belongs to you.',
  ],
  ['Can it match how our clinic works?', 'Yes. We adjust fees, tests, roles and workflows during setup.'],
  [
    'What if our internet goes down?',
    'PCMS runs online, so it needs a connection. We help you set up a backup connection, like a 4G router, and a simple paper fallback. Anything written on paper is entered once you’re back online.',
  ],
  [
    'What if something breaks?',
    `You call us directly, and we fix most issues remotely, without a site visit. We’re available ${hours.text}, Nepal time.`,
  ],
];

// Describes PCMS itself for search engines; Vektide's own details come from Base.
const product = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PCMS — Polyclinic Management System',
  alternateName: 'PCMS',
  description,
  url: new URL('/pcms', Astro.site).href,
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Clinic management',
  operatingSystem: 'Web',
  areaServed: { '@type': 'Country', name: 'Nepal' },
  provider: { '@id': new URL('/#organization', Astro.site).href },
};
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(product)} />
  <Navbar />
  <main class="min-h-screen">
    <PcmsHero />
    <Features />
    <Modules />
    <Reception />
    <Laboratory />
    <Admin />
    <Steps />
    <Hosted />
    <Proof />
    <Faq heading="Questions, answered." intro="What clinic owners ask us most before switching to PCMS." faqs={faqs} />
  </main>
  <FloatingCta />
  <Footer headline="See PCMS in your clinic." />
</Base>
