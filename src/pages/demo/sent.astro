---
// Where Web3Forms sends people after a demo request when JS is off. Kept out of search.
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Base title="Request sent | Vektide" description="Your demo request reached Vektide." noindex>
  <Navbar />
  <main class="flex min-h-svh flex-col items-center justify-center px-4 pt-36 pb-24 text-center sm:px-8">
    <span class="grid size-14 place-items-center rounded-full bg-lime">
      <svg viewBox="0 0 20 20" aria-hidden="true" class="size-6"><path d="m5 10.5 3.2 3L15 6.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
    <h1 class="mt-8 text-5xl leading-[0.95] font-bold tracking-tighter sm:text-7xl">Request sent.</h1>
    <p class="mx-auto mt-6 max-w-md text-lg text-soft">We'll call you within one working day to set a time for your demo.</p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-ink px-6 py-3 text-[15px] font-medium text-white transition-colors duration-300 hover:bg-lime hover:text-ink">
        Back to home
      </a>
      <a href="mailto:contact@vektide.com" class="rounded-full bg-pill px-6 py-3 text-[15px] font-medium transition-colors duration-300 hover:bg-line">
        contact@vektide.com
      </a>
    </div>
  </main>
  <Footer />
</Base>
