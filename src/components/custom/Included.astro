---
// What comes with every system: the dark panel (as in PCMS's Proof) with a white-check list,
// and the PCMS card from About as the proof that we build this way.
const included = [
  'Works on phone and computer',
  'Your own private system and database',
  'Hosting, security and backups handled by us',
  'Nepali dates and rupees built in',
  'Staff training and simple guides',
  'A direct line to the developers who built it',
];
const arrowRight = `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section class="relative z-10 bg-panel text-white shadow-[0_-30px_60px_-20px_rgb(8_15_38/0.25)]">
  <div class="mx-auto grid max-w-[1280px] gap-14 px-4 py-24 sm:px-8 md:grid-cols-[1.4fr_1fr] md:gap-20 md:py-36">
    <div>
      <h2 class="max-w-xl text-5xl leading-[0.95] font-bold tracking-tighter text-balance sm:text-6xl">What comes with every system.</h2>
      <ul class="mt-12 grid gap-x-10 sm:grid-cols-2">
        {included.map((item) => (
          <li class="flex items-start gap-4 border-t border-white/10 py-5">
            <span aria-hidden="true" class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-white">
              <svg viewBox="0 0 12 12" class="size-3 fill-none stroke-brand stroke-[1.8]" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.2 2.3 2.3 4.7-5" /></svg>
            </span>
            <span class="text-lg">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <a href="/pcms" class="group/card grid grid-cols-[120px_1fr] gap-4 self-end sm:grid-cols-[180px_minmax(0,260px)] sm:gap-6">
      <span class="relative grid aspect-square place-items-center overflow-hidden bg-brand">
        <img
          src="/logo/vektide-mark-white-256.png"
          srcset="/logo/vektide-mark-white-128.png 128w, /logo/vektide-mark-white-256.png 256w"
          sizes="(min-width: 640px) 94px, 62px"
          alt=""
          width="256"
          height="256"
          loading="lazy"
          class="size-[52%] transition-transform duration-600 ease-out-expo group-hover/card:scale-106 group-hover/card:-rotate-4 motion-reduce:transition-none"
        />
        <span class="absolute top-2.5 right-2.5 grid size-9 place-items-center rounded-full bg-white text-ink transition-transform duration-350 ease-out-expo group-hover/card:-rotate-45 motion-reduce:transition-none [&_svg]:size-4">
          <Fragment set:html={arrowRight} />
        </span>
      </span>
      <span class="flex flex-col gap-2">
        <span class="text-[15px] font-bold">Built the same way: PCMS</span>
        <span class="text-[15px] leading-snug text-white/70">Our polyclinic system, live at Gorkhakali Polyclinic.</span>
        <span class="mt-auto text-sm text-white/60 underline decoration-white/25 underline-offset-4 transition-colors group-hover/card:text-white group-hover/card:decoration-white">Explore PCMS</span>
      </span>
    </a>
  </div>
</section>
