---
// Featured product: a full-screen dark panel. The problems section above freezes in place
// and this panel scrolls up over it like a curtain, then the page carries on.
// Left: the clinic owner's words, big. Right: a PCMS screen (HTML replica, invented data).
// TODO: replace the draft quote and attribution with the owner's real words before launch.
const quote = 'We used to close the day not knowing what we’d actually earned. Now every rupee is on one screen before the last patient leaves.';

const stats = [
  ['Collected today', 'NPR 20,559', 'text-emerald-600', '+8% vs yesterday'],
  ['Pending lab fees', 'NPR 1,100', 'text-amber-600', '1 patient owes'],
  ['Patients today', '31', 'text-soft', '6 in the queue'],
  ['Doctors to pay', 'NPR 10,850', 'text-soft', 'Settle at closing'],
];
const queue = [
  ['14', 'Sita Shrestha', 'With doctor', 'bg-lime text-ink'],
  ['15', 'Ram Bahadur Thapa', 'Waiting', 'bg-pill text-soft'],
  ['16', 'Anju Gurung', 'Waiting', 'bg-pill text-soft'],
];
const lab = [
  ['LAB-0142', 'CBC, Lipid profile', 'Report ready', 'bg-emerald-50 text-emerald-700'],
  ['XR-0031', 'Chest PA view', 'In progress', 'bg-amber-50 text-amber-700'],
  ['USG-0019', 'Abdomen', 'Unpaid', 'bg-rose-50 text-rose-700'],
];
const arrowRight = `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<section
  id="work"
  data-featured
  class="relative z-10 flex min-h-svh items-center bg-[radial-gradient(120%_80%_at_0%_0%,rgb(255_255_255/0.07),transparent_55%),linear-gradient(160deg,#1d1d1f_0%,#121213_55%,#0b0b0c_100%)] text-white shadow-[0_-30px_60px_-20px_rgb(0_0_0/0.25)]"
>
  <div class="mx-auto grid w-full max-w-[1280px] items-center gap-12 px-4 py-24 sm:px-8 md:grid-cols-[1fr_1.15fr] md:gap-16 md:py-32">
    <!-- Left: testimonial -->
    <div>
      <p data-f-in class="text-sm text-white/50">Flagship product · PCMS</p>
      <!-- Split into letters so it can light up as it scrolls; screen readers get the plain quote. -->
      <blockquote aria-label={quote} class="mt-6 text-3xl leading-[1.12] font-bold tracking-tight text-balance sm:text-4xl lg:text-[44px]">
        {`“${quote}”`.split(' ').map((word, i, words) => (
          <>
            <span aria-hidden="true" class="inline-block whitespace-nowrap">
              {[...word].map((ch) => <span data-f-char>{ch}</span>)}
            </span>
            {i < words.length - 1 && ' '}
          </>
        ))}
      </blockquote>
      <p data-f-in class="mt-6 text-white/60">[Name], [Role], Gorkhakali Polyclinic</p>

      <div data-f-in class="mt-12 border-t border-white/10 pt-8">
        <p class="text-xl font-semibold">PCMS, the polyclinic, digitized.</p>
        <p class="mt-2 max-w-md text-white/60">
          Reception, lab and admin in one system. Every consultation and lab fee tracked, every pending payment visible.
        </p>
        <a
          href="/pcms"
          class="group/cta mt-6 inline-flex items-center gap-2 rounded-full bg-lime px-6 py-3 text-[15px] font-medium text-ink transition-colors duration-300 hover:bg-white [&_svg]:size-4"
        >
          Explore PCMS
          <span class="transition-transform duration-300 group-hover/cta:translate-x-0.5"><Fragment set:html={arrowRight} /></span>
        </a>
      </div>
    </div>

    <!-- Right: product screen -->
    <div data-f-shot class="overflow-hidden rounded-2xl bg-white text-left text-[13px] text-ink shadow-[0_50px_100px_-30px_rgb(0_0_0/0.9)] ring-1 ring-white/10">
      <div class="flex h-11 items-center gap-2 border-b border-line bg-[#fafafa] px-4">
        <span class="grid size-6 place-items-center rounded-md bg-ink text-[10px] font-bold text-lime">P</span>
        <span class="font-medium">Demo Polyclinic</span>
        <span class="text-soft">· Clinic overview</span>
        <span class="ml-auto text-soft">Mon, 12 Oct</span>
      </div>

      <div class="grid gap-3 p-4">
        <div class="grid grid-cols-2 gap-3">
          {stats.map(([label, value, tone, note]) => (
            <div class="rounded-xl border border-line p-3">
              <p class="text-[11px] text-soft">{label}</p>
              <p class="mt-0.5 text-lg font-semibold tracking-tight tabular-nums">{value}</p>
              <p class:list={['text-[11px]', tone]}>{note}</p>
            </div>
          ))}
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-line p-3">
            <p class="mb-1 font-medium">Token queue · Dr. Koirala</p>
            {queue.map(([token, name, status, pill]) => (
              <p class="flex items-center gap-2 border-t border-line py-2">
                <span class="w-6 text-soft tabular-nums">{token}</span>
                <span class="truncate">{name}</span>
                <span class:list={['ml-auto shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium', pill]}>{status}</span>
              </p>
            ))}
          </div>
          <div class="rounded-xl border border-line p-3">
            <p class="mb-1 font-medium">Laboratory</p>
            {lab.map(([id, test, status, pill]) => (
              <p class="flex items-center gap-2 border-t border-line py-2">
                <span class="min-w-0">
                  <span class="block truncate">{test}</span>
                  <span class="block text-[11px] text-soft tabular-nums">{id}</span>
                </span>
                <span class:list={['ml-auto shrink-0 rounded-full px-2 py-0.5 text-[11px] font-medium', pill]}>{status}</span>
              </p>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-featured]')!;
  const problems = document.querySelector<HTMLElement>('[data-problems]');
  const intro = section.querySelectorAll('[data-f-in]');
  const quoteChars = section.querySelectorAll('[data-f-char]');
  const shot = section.querySelector('[data-f-shot]');

  // Curtain: once the problems section's bottom reaches the bottom of the screen it stays put,
  // and this section slides up over it. No pin spacing, so the scroll length doesn't change.
  if (problems) {
    ScrollTrigger.create({ trigger: problems, start: 'bottom bottom', endTrigger: section, end: 'top top', pin: true, pinSpacing: false });
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // The frozen section sinks back a little as the curtain covers it.
    if (problems) {
      gsap.to(problems, { scale: 0.94, opacity: 0.4, ease: 'none', scrollTrigger: { trigger: section, start: 'top bottom', end: 'top top', scrub: true } });
    }

    // Testimonial: each letter goes from faint to solid as the quote scrolls up the screen.
    gsap.fromTo(
      quoteChars,
      { opacity: 0.15 },
      { opacity: 1, stagger: 0.04, ease: 'none', scrollTrigger: { trigger: section.querySelector('blockquote'), start: 'top 85%', end: 'bottom 45%', scrub: true } },
    );

    // Contents arrive as the curtain nears the top.
    gsap
      .timeline({ scrollTrigger: { trigger: section, start: 'top 45%', once: true } })
      .fromTo(intro, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.9, stagger: 0.1, ease: 'power3.out' })
      .fromTo(shot, { opacity: 0, y: 50, rotate: 2 }, { opacity: 1, y: 0, rotate: 0, duration: 1.1, ease: 'power3.out' }, 0.15);
  }
</script>
