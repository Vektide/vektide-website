---
import AppFrame from './AppFrame.astro';

const kpis = [
  ['Revenue this quarter', 'NPR 48.6 L', '+12.4% vs last quarter'],
  ['Average order', 'NPR 4,860', '+NPR 310 vs last quarter'],
  ['Repeat customers', '68%', '214 of 315 parties'],
];
// Monthly revenue in lakhs, Baisakh to Chaitra (invented).
const months = ['Bai', 'Jes', 'Asa', 'Shr', 'Bha', 'Asw', 'Kar', 'Man', 'Pou', 'Mag', 'Fal', 'Cha'];
const values = [11.2, 12.8, 12.1, 13.9, 14.6, 15.8, 18.4, 17.1, 16.3, 17.9, 19.6, 21.2];
const W = 620, H = 230, max = 24;
const pts = values.map((v, i) => [(i / (values.length - 1)) * W, H - (v / max) * H]);
const line = pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const area = `0,${H} ${line} ${W},${H}`;

const products = [
  ['Basmati rice, 25 kg', 92],
  ['Sunflower oil, 15 L', 78],
  ['Sugar, 50 kg', 64],
  ['Masoor dal, 30 kg', 51],
  ['Tea dust, 10 kg', 37],
] as const;
---

<AppFrame active="Analytics" title="Analytics" subtitle="Sales trends across the year, by month and product.">
  <span slot="actions" class="rounded-lg border border-line px-3 py-1.5 text-soft">This year, 2083</span>

  <div class="grid h-full grid-rows-[auto_1fr] gap-3">
    <div class="grid grid-cols-3 gap-3">
      {kpis.map(([label, value, note]) => (
        <div class="rounded-xl border border-line p-4">
          <p class="text-[12px] text-soft">{label}</p>
          <p class="mt-1 text-[22px] font-semibold tracking-tight tabular-nums">{value}</p>
          <p class="mt-1 text-[11px] text-emerald-600">{note}</p>
        </div>
      ))}
    </div>

    <div class="grid min-h-0 grid-cols-[1.7fr_1fr] gap-3">
      <div class="flex flex-col rounded-xl border border-line p-4">
        <p class="font-medium">Revenue by month <span class="font-normal text-soft">(NPR lakh)</span></p>
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="mt-4 h-full min-h-0 w-full flex-1 overflow-visible">
          <polygon points={area} class="fill-lime/40" />
          <polyline points={line} fill="none" class="stroke-ink" stroke-width="2" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="mt-2 grid grid-cols-12 text-center text-[11px] text-soft">{months.map((m) => <span>{m}</span>)}</div>
      </div>

      <div class="rounded-xl border border-line p-4">
        <p class="mb-4 font-medium">Top products</p>
        <div class="grid gap-4">
          {products.map(([name, pct]) => (
            <div>
              <div class="mb-1.5 flex justify-between"><span>{name}</span><span class="text-soft tabular-nums">{pct}%</span></div>
              <span class="block h-2 rounded-full bg-ink" style={`width:${pct}%`}></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AppFrame>
