---
// Shell for the hero mockups: a made-up wholesaler's back-office app, drawn at
// 1280×720 and scaled down by the hero. Invented data only.
interface Props {
  active: string;
  title: string;
  subtitle: string;
}
const { active, title, subtitle } = Astro.props;
const nav = ['Dashboard', 'Sales', 'Inventory', 'Billing', 'Analytics', 'Customers', 'Admin'];
---

<div class="flex size-full bg-white text-left text-[13px] text-ink">
  <aside class="flex w-[210px] shrink-0 flex-col gap-1 border-r border-line bg-[#fafafa] p-4">
    <div class="mb-5 flex items-center gap-2.5">
      <span class="grid size-8 place-items-center rounded-lg bg-ink text-[11px] font-bold text-lime">HT</span>
      <span>
        <span class="block leading-tight font-semibold">Himal Traders</span>
        <span class="block text-[11px] text-soft">Wholesale, Kathmandu</span>
      </span>
    </div>
    {nav.map((item) => (
      <span class:list={['flex items-center gap-2.5 rounded-lg px-2.5 py-2', item === active ? 'bg-white font-medium shadow-xs ring-1 ring-line' : 'text-soft']}>
        <span class:list={['size-3.5 rounded', item === active ? 'bg-lime' : 'bg-line']}></span>
        {item}
      </span>
    ))}
    <div class="mt-auto flex items-center gap-2 rounded-lg border border-line bg-white p-2">
      <span class="grid size-7 place-items-center rounded-full bg-pill text-[10px] font-semibold">RT</span>
      <span>
        <span class="block leading-tight font-medium">Rajesh Tamang</span>
        <span class="block text-[11px] text-soft">Owner</span>
      </span>
    </div>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="flex h-14 shrink-0 items-center gap-3 border-b border-line px-6 text-soft">
      <span class="flex w-[300px] items-center gap-2 rounded-lg border border-line px-3 py-1.5">
        <span class="size-3 rounded-full border-[1.5px] border-current"></span>Search parties, items, invoices
      </span>
      <span class="ml-auto">Mon, 12 Oct</span>
      <span class="size-7 rounded-full bg-pill"></span>
      <span class="size-7 rounded-full bg-pill"></span>
    </div>
    <div class="flex items-end justify-between px-6 pt-5 pb-4">
      <div>
        <p class="text-[20px] font-semibold tracking-tight">{title}</p>
        <p class="text-soft">{subtitle}</p>
      </div>
      <slot name="actions" />
    </div>
    <div class="min-h-0 flex-1 px-6 pb-6">
      <slot />
    </div>
  </div>
</div>
