---
// A PCMS app window: title bar (blue diamond, screen name, note) over a 16:9 screenshot from
// the demo clinic (src/assets/screens, invented data).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  title: string;
  note: string;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, title, note, sizes, eager = false, class: cls } = Astro.props;
---

<figure class:list={['overflow-hidden rounded-xl border border-line bg-white text-left text-ink shadow-[0_30px_60px_-30px_rgb(0_0_0/0.25)]', cls]}>
  <figcaption class="flex h-[34px] items-center gap-2 border-b border-line bg-pill/60 px-4 text-[13px] whitespace-nowrap sm:h-[42px]">
    <span class="size-2 shrink-0 rotate-45 rounded-[2px] bg-brand"></span>
    <span class="font-medium">{title}</span>
    <span class="truncate text-soft">· {note}</span>
  </figcaption>
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280, 1920]}
    sizes={sizes}
    quality={85}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="block aspect-[16/9] w-full"
  />
</figure>
