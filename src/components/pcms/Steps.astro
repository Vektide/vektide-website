---
// Getting started: the four steps scroll by on the left while a card sticks on the right and
// swaps to each step as it reaches the middle of the screen (its checklist ticks in). A rail
// fills as you go. Phones: each step shows its own card inline. The price line sits underneath.
import { hours } from '../../data/contact';

const steps: { name: string; body: string; checks: string[] }[] = [
  { name: 'Demo', body: 'We show you PCMS with your clinic’s workflow in mind.', checks: ['Your reception flow', 'Your lab and tests', 'Your daily reports'] },
  { name: 'Setup', body: 'We set up your clinic’s private system and configure doctors, tests, fees and staff accounts.', checks: ['Doctors', 'Tests', 'Fees', 'Staff accounts'] },
  { name: 'Training', body: 'Your team learns it in a day.', checks: ['Reception', 'Laboratory', 'Admin'] },
  { name: 'Go live', body: 'We stay on call while you switch over.', checks: ['Switch-over day, with us on call', `Support ${hours.text}`] },
];
---

<section data-steps class="relative z-10 bg-white">
  <div class="mx-auto max-w-[1280px] px-4 py-24 sm:px-8 md:py-36">
    <div class="grid gap-6 md:grid-cols-2 md:items-end md:gap-16">
      <h2 data-reveal class="text-5xl leading-[0.95] font-bold tracking-tighter sm:text-6xl">Getting <span class="text-soft">started.</span></h2>
      <p data-reveal class="max-w-md text-lg text-soft">From first demo to a clinic running on PCMS, with the same team at every step.</p>
    </div>

    <div class="mt-14 grid gap-8 md:mt-20 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <!-- Left: the steps, on a rail -->
      <ol data-step-list class="relative lg:pl-10">
        <span aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-px bg-line lg:block"></span>
        <span data-step-fill aria-hidden="true" class="absolute inset-y-0 left-0 hidden w-px origin-top scale-y-0 bg-brand lg:block"></span>

        {steps.map((s, i) => (
          <li data-step class="border-t border-line py-10 first:border-t-0 lg:flex lg:min-h-[70vh] lg:flex-col lg:justify-center lg:border-t-0 lg:py-0">
            <h3
              data-step-title
              data-active={i === 0 ? '' : undefined}
              class="relative flex items-baseline gap-5 text-4xl font-bold tracking-tight transition-colors duration-500 sm:text-5xl lg:in-[.js]:text-ink/20 lg:in-[.js]:data-active:text-ink"
            >
              <span
                data-step-tick
                data-active={i === 0 ? '' : undefined}
                aria-hidden="true"
                class="absolute top-1/2 -left-10 hidden size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-line ring-4 ring-white transition-colors duration-500 data-active:bg-brand lg:block"
              ></span>
              <span class="text-[13px] font-medium tracking-normal text-brand tabular-nums">0{i + 1}</span>
              {s.name}
            </h3>
            <p class="mt-4 max-w-sm text-lg text-soft">{s.body}</p>
            <!-- Phones: this step's checklist, inline. Desktop: read by screen readers only (the sticky card mirrors it). -->
            <ul class="mt-6 space-y-3 lg:sr-only">
              {s.checks.map((c) => (
                <li class="flex items-center gap-3 rounded-xl bg-pill px-4 py-3">
                  <span aria-hidden="true" class="grid size-6 shrink-0 place-items-center rounded-full bg-brand">
                    <svg viewBox="0 0 12 12" class="size-3 fill-none stroke-white stroke-[1.8]" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.2 2.3 2.3 4.7-5" /></svg>
                  </span>
                  {c}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <!-- Right: the sticky card (desktop only) -->
      <div class="hidden lg:block" aria-hidden="true">
        <div class="sticky top-[max(7rem,calc(50vh-15rem))] grid rounded-[32px] bg-pill p-8">
          {steps.map((s, i) => (
            <div data-step-panel class:list={['col-start-1 row-start-1 rounded-[24px] bg-white p-10 ring-1 ring-line', i > 0 && 'invisible opacity-0']}>
              <p class="text-[13px] font-medium tracking-[0.14em] text-brand uppercase">Step 0{i + 1}</p>
              <p class="mt-3 text-3xl font-bold tracking-tight">{s.name}</p>
              <p class="mt-3 max-w-sm text-lg text-soft">{s.body}</p>
              <ul class="mt-8 space-y-3">
                {s.checks.map((c) => (
                  <li data-check class="flex items-center gap-3 rounded-xl bg-pill px-4 py-3">
                    <span class="grid size-6 shrink-0 place-items-center rounded-full bg-brand">
                      <svg viewBox="0 0 12 12" class="size-3 fill-none stroke-white stroke-[1.8]" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.2 2.3 2.3 4.7-5" /></svg>
                    </span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div data-reveal class="mt-16 max-w-md border-t border-line pt-6">
      <h3 class="font-bold">What it costs</h3>
      <p class="mt-2 text-soft">
        A one-time license for the core system and the modules you choose, plus a yearly plan for hosting, updates, backups and support.
        Billed in rupees.
      </p>
      <a href="/demo" class="mt-4 inline-block font-medium text-brand underline decoration-brand-200 underline-offset-4 transition-colors hover:decoration-brand">Get a quote</a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-steps]')!;
  const steps = [...section.querySelectorAll<HTMLElement>('[data-step]')];
  const titles = [...section.querySelectorAll<HTMLElement>('[data-step-title]')];
  const ticks = [...section.querySelectorAll<HTMLElement>('[data-step-tick]')];
  const panels = [...section.querySelectorAll<HTMLElement>('[data-step-panel]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = 0;

  const flag = (el: HTMLElement, on: boolean) => (on ? el.setAttribute('data-active', '') : el.removeAttribute('data-active'));

  function show(next: number) {
    if (next === active) return;
    const leaving = panels[active];
    const forward = next > active;
    active = next;
    titles.forEach((t, i) => flag(t, i === next));
    ticks.forEach((t, i) => flag(t, i <= next));

    // New card rises in (from below going down, from above going back); the old one slips away.
    const d = reduce ? 0 : 1;
    gsap.to(leaving, { autoAlpha: 0, y: forward ? -20 : 20, duration: 0.35 * d, ease: 'power2.in', overwrite: true });
    gsap
      .timeline()
      .fromTo(panels[next], { autoAlpha: 0, y: forward ? 28 : -28 }, { autoAlpha: 1, y: 0, duration: 0.6 * d, ease: 'power3.out', overwrite: true }, 0.1 * d)
      .from(panels[next].querySelectorAll('[data-check]'), { autoAlpha: 0, x: -12, duration: 0.4 * d, stagger: 0.08 * d, ease: 'power3.out' }, 0.3 * d);
  }

  gsap.matchMedia().add('(min-width: 1024px)', () => {
    // Each step takes over the card when it reaches the middle of the screen. Enter callbacks
    // (not isActive) so a fast jump past a step still lands on the right card.
    steps.forEach((step, i) =>
      ScrollTrigger.create({ trigger: step, start: 'top center', end: 'bottom center', onEnter: () => show(i), onEnterBack: () => show(i) }),
    );

    // The rail fills from the first step to the last.
    gsap.fromTo(
      section.querySelector('[data-step-fill]'),
      { scaleY: 0 },
      { scaleY: 1, ease: 'none', scrollTrigger: { trigger: section.querySelector('[data-step-list]'), start: 'top center', end: 'bottom center', scrub: true } },
    );
  });
</script>
