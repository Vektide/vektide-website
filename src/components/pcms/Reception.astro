---
// Chapter 1 · Reception: three small desk moments (register, token, fee), then the reception
// dashboard with the "doctors don't log in" line.
import Chapter from './Chapter.astro';
import Window from './Window.astro';
import TokenSlip from './TokenSlip.astro';
import reception from '../../assets/screens/desk-reception.png';

const card = 'flex flex-col rounded-[28px] bg-white p-6 ring-1 ring-line';
const stage = 'grid h-64 place-items-center overflow-hidden rounded-2xl bg-pill p-4';
const fields: [string, string][] = [
  ['Patient', 'Anita Rai, 34, F'],
  ['Phone', '98000 09682'],
  ['Doctor', 'Dr. R. B. Thapa'],
];
---

<Chapter id="how-it-works" word="Reception." intro="Register visits, issue tokens, manage the queue and collect consultation fees in seconds." tone="pill">
  <div class="grid gap-4 md:grid-cols-3 lg:gap-6">
    <article data-reveal class={card}>
      <div data-mock="register" aria-hidden="true" class={stage}>
        <div class="w-full space-y-2.5 rounded-xl bg-white p-4 text-[13px] shadow-sm">
          <p class="font-medium">New visit</p>
          {fields.map(([label, value]) => (
            <p class="flex justify-between gap-3 rounded-lg border border-line px-3 py-2">
              <span class="text-soft">{label}</span>
              <span data-type={value} class="truncate font-medium">{value}</span>
            </p>
          ))}
          <p data-save class="rounded-lg bg-brand py-2 text-center font-medium text-white">Register · issue token</p>
        </div>
      </div>
      <h3 class="mt-6 text-xl font-bold tracking-tight">Register a visit</h3>
      <p class="mt-1.5 text-soft">Patient, doctor and fee on one screen.</p>
    </article>

    <article data-reveal class={card}>
      <div data-mock="token" class={stage}>
        <TokenSlip token="#14" class="scale-90" style="transform: rotate(-4deg)" />
      </div>
      <h3 class="mt-6 text-xl font-bold tracking-tight">Issue a token</h3>
      <p class="mt-1.5 text-soft">Printed with your clinic’s name and logo.</p>
    </article>

    <article data-reveal class={card}>
      <div aria-hidden="true" class={stage}>
        <div class="w-full rounded-xl bg-white p-4 text-[13px] shadow-sm">
          <p class="flex justify-between"><span class="font-medium">Receipt 35EEC979</span><span class="text-soft">Cash</span></p>
          <p class="mt-3 flex justify-between border-t border-line pt-3"><span>Consultation</span><span class="tabular-nums">NPR 500</span></p>
          <p class="mt-2 flex justify-between text-soft"><span>Refund · cancelled visit</span><span class="tabular-nums">− NPR 500</span></p>
          <p class="mt-3 flex items-center justify-between rounded-lg bg-brand-50 px-3 py-2 text-brand"><span class="font-medium">Recorded</span><span>✓</span></p>
        </div>
      </div>
      <h3 class="mt-6 text-xl font-bold tracking-tight">Fees and refunds</h3>
      <p class="mt-1.5 text-soft">Collected and recorded as they happen.</p>
    </article>
  </div>

  <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
    <div>
      <p data-reveal class="text-[13px] font-medium tracking-[0.14em] text-brand uppercase">No login for doctors</p>
      <h2 data-reveal class="mt-4 text-4xl leading-[0.95] font-bold tracking-tighter sm:text-5xl">Doctors see patients. <span class="text-soft">The system handles the rest.</span></h2>
      <p data-reveal class="mt-6 max-w-md text-lg text-soft">Doctors don’t need to log in. Reception and the lab keep every visit, test and fee in order.</p>
      <div data-reveal class="mt-8 flex flex-wrap gap-3">
        <a href="/demo" class="rounded-full bg-brand px-6 py-3 text-[15px] font-medium text-white transition-colors duration-300 hover:bg-brand-700">Request a demo</a>
        <a href="/case-studies/gorkhakali-polyclinic" class="rounded-full bg-white px-6 py-3 text-[15px] font-medium ring-1 ring-line transition-colors duration-300 hover:bg-brand-50 hover:text-brand">See the case study</a>
      </div>
    </div>
    <div data-reveal class="relative">
      <Window
        src={reception}
        alt="PCMS reception dashboard: patients registered today, fees still to collect, the consultation queue by doctor and clinic notices"
        title="Reception"
        note="Today’s queue and fees to collect"
        sizes="(min-width: 1280px) 640px, (min-width: 1024px) 52vw, calc(100vw - 32px)"
      />
      <div aria-hidden="true" class="absolute -bottom-6 -left-3 flex items-center gap-3 rounded-2xl bg-white py-3 pr-5 pl-3 shadow-[0_24px_40px_-16px_rgb(0_0_0/0.3)] ring-1 ring-line sm:-left-6">
        <span class="grid size-11 place-items-center rounded-xl bg-brand text-lg font-black text-white tabular-nums">15</span>
        <span class="text-[13px] leading-tight"><span class="block font-medium">Now serving</span><span class="text-soft">Dr. R. B. Thapa</span></span>
      </div>
    </div>
  </div>
</Chapter>

<script>
  import gsap from 'gsap';
  import { loop } from '../../scripts/reveal';

  // New visit: each field types itself in, then the button presses.
  {
    const el = document.querySelector<HTMLElement>('[data-mock="register"]')!;
    const fields = el.querySelectorAll<HTMLElement>('[data-type]');
    const tl = gsap.timeline({ repeat: -1, repeatDelay: 2 }).call(() => fields.forEach((f) => (f.textContent = '')));
    fields.forEach((f) => {
      const text = f.dataset.type!;
      const o = { n: 0 };
      tl.to(o, { n: text.length, duration: text.length * 0.045, ease: 'none', onUpdate: () => (f.textContent = text.slice(0, Math.round(o.n))) }, '+=0.25');
    });
    tl.to(el.querySelector('[data-save]'), { scale: 0.95, duration: 0.12, yoyo: true, repeat: 1 }, '+=0.3');
    loop(el, tl);
  }

  // Token slip: the number ticks over as each patient is called.
  {
    const el = document.querySelector<HTMLElement>('[data-mock="token"]')!;
    const n = el.querySelector<HTMLElement>('[data-slip-token]')!;
    const tl = gsap.timeline({ repeat: -1 });
    [15, 16, 17, 14].forEach((v) =>
      tl
        .to(n, { yPercent: -40, autoAlpha: 0, duration: 0.25, ease: 'power2.in' }, '+=1.6')
        .call(() => (n.textContent = `#${v}`))
        .fromTo(n, { yPercent: 40 }, { yPercent: 0, autoAlpha: 1, duration: 0.35, ease: 'power3.out' }),
    );
    loop(el, tl);
  }
</script>
