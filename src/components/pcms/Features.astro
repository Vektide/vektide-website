---
// Key features: a quiet, hairline-ruled list. Pending payments is the core pitch, so it
// runs the full width with bigger type; the rest sit in two columns, and the managed-hosting
// item (the longest) closes the list full width. No numbers: not a sequence.
const [lead, ...rest] = [
  {
    title: 'Pending payment tracking',
    body: 'Never lose a lab fee again. Every unpaid amount is visible until it’s settled.',
    icon: '<path d="M4 2h8v12l-2-1.2L8 14l-2-1.2L4 14z"/><path d="M6 6h4M6 9h2.5"/>',
  },
  {
    title: 'Token and queue management',
    body: 'Patients know their turn; reception stays calm.',
    icon: '<path d="M3 4h10M3 8h10M3 12h6"/>',
  },
  {
    title: 'Separate money flows',
    body: 'Consultation and lab income tracked independently, reported together.',
    icon: '<path d="M2 5h9M8 2l3 3-3 3"/><path d="M14 11H5M8 8l-3 3 3 3"/>',
  },
  {
    title: 'Role-based access',
    body: 'Each staff member sees only what their job needs.',
    icon: '<path d="M8 2 3 4v4c0 3 2.2 5.2 5 6 2.8-.8 5-3 5-6V4z"/>',
  },
  {
    title: 'Daily and monthly reports',
    body: 'Know your numbers without counting cash twice.',
    icon: '<path d="M2 14h12"/><path d="M4 11V8M8 11V4M12 11V6"/>',
  },
  {
    title: 'Your own private system, managed by us',
    body: 'Your clinic gets its own system and its own database, kept completely separate from every other clinic. We handle hosting, updates, backups and security. Nothing to install.',
    icon: '<rect x="2.5" y="2.5" width="11" height="4.5" rx="1"/><rect x="2.5" y="9" width="11" height="4.5" rx="1"/><path d="M5 4.75h.01M5 11.25h.01"/>',
  },
];

const tile = 'grid size-11 shrink-0 place-items-center rounded-lg bg-pill';
const svg = 'size-5 fill-none stroke-current stroke-[1.4]';
---

<section class="mx-auto max-w-[1280px] px-4 py-24 sm:px-8 md:py-36">
  <h2 class="max-w-2xl text-5xl text-balance leading-[0.95] font-bold tracking-tighter sm:text-6xl">What PCMS keeps track of.</h2>

  <div class="mt-14 grid gap-x-16 md:mt-20 md:grid-cols-2">
    <div class="grid gap-5 border-t border-line py-10 sm:grid-cols-[auto_1fr] sm:gap-7 md:col-span-2 md:py-12">
      <span class={tile}><svg viewBox="0 0 16 16" aria-hidden="true" class={svg} stroke-linecap="round" stroke-linejoin="round" set:html={lead.icon} /></span>
      <div>
        <h3 class="text-3xl font-bold tracking-tight sm:text-4xl">{lead.title}</h3>
        <p class="mt-3 max-w-xl text-lg text-soft sm:text-xl">{lead.body}</p>
      </div>
    </div>

    {rest.map((f, i) => (
      <div class:list={['grid grid-cols-[auto_1fr] gap-5 border-t border-line py-8 sm:gap-7', i === rest.length - 1 && 'md:col-span-2']}>
        <span class={tile}><svg viewBox="0 0 16 16" aria-hidden="true" class={svg} stroke-linecap="round" stroke-linejoin="round" set:html={f.icon} /></span>
        <div>
          <h3 class="text-xl font-bold tracking-tight sm:text-2xl">{f.title}</h3>
          <p class="mt-2 max-w-xl text-soft">{f.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>
