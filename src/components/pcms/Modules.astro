---
// Core + add-ons as a bento: the core sits in a grey strip of blue-check pills (included),
// and the eight add-on modules fill a hairline 4 × 2 grid (optional).
const core = ['Consultation desk', 'Patients', 'Doctors and services', 'Staff roles', 'Your clinic’s name and logo'];

const addOns: [string, string, string][] = [
  ['Laboratory and diagnostics', 'Lab, X-ray, ultrasound and ECG: orders, sample queue, results and lab billing.', '<path d="M6 2h4M6.5 2v4L3 13a1 1 0 0 0 .9 1.5h8.2A1 1 0 0 0 13 13L9.5 6V2"/><path d="M4.5 10h7"/>'],
  ['Appointments', 'Book ahead, then check patients in with one click.', '<rect x="2.5" y="3.5" width="11" height="10" rx="1.5"/><path d="M2.5 6.5h11M5.5 2v3M10.5 2v3"/><path d="m6 10 1.4 1.4L10 9"/>'],
  ['Doctor payouts', 'Calculate what each doctor earned and record settlements.', '<rect x="2" y="4" width="12" height="8" rx="1.5"/><circle cx="8" cy="8" r="1.8"/>'],
  ['Staff and payroll', 'Staff directory, monthly salary slips and payroll.', '<circle cx="6" cy="5.5" r="2.2"/><path d="M2.5 13c.4-2 1.8-3.2 3.5-3.2S9.1 11 9.5 13"/><path d="M11 4.5v5M9.8 6h1.9a.9.9 0 0 1 0 1.8H10"/>'],
  ['Staff schedules', 'Weekly shifts and duty rotas.', '<circle cx="8" cy="8" r="5.5"/><path d="M8 5v3l2 1.5"/>'],
  ['Clinic expenses', 'Rent, electricity, supplies and other day-to-day spending.', '<path d="M4 2h8v12l-2-1.2L8 14l-2-1.2L4 14z"/><path d="M6 6h4M6 9h2.5"/>'],
  ['Doctor schedules', 'Weekly sitting hours, leaves and delays.', '<path d="M3 4h10M3 8h10M3 12h6"/>'],
  ['Doctor presence', 'Show reception which doctors are in the clinic right now.', '<circle cx="8" cy="6" r="2.5"/><path d="M3.5 14c.5-2.5 2.3-4 4.5-4s4 1.5 4.5 4"/><circle cx="12.5" cy="3.5" r="1.2" fill="currentColor"/>'],
];
---

<section class="relative z-10 bg-white">
  <div class="mx-auto max-w-[1280px] px-4 pb-24 sm:px-8 md:pb-36">
    <div class="grid gap-6 md:grid-cols-2 md:items-end md:gap-16">
      <h2 data-reveal class="text-5xl leading-[0.95] font-bold tracking-tighter sm:text-6xl">Start with the core. <span class="text-soft">Add what you need.</span></h2>
      <p data-reveal class="max-w-md text-lg text-soft">
        Every clinic gets the core system. Add modules now or later, and pay only for the ones you use. A new module goes live the same
        day, with no reinstall.
      </p>
    </div>

    <div data-reveal class="mt-14 rounded-[28px] bg-pill p-6 sm:p-8 md:mt-20">
      <p class="text-[13px] font-medium tracking-[0.14em] text-soft uppercase">Core · included for every clinic</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {core.map((name) => (
          <li class="flex items-center gap-2.5 rounded-full bg-white py-2 pr-4 pl-2 ring-1 ring-line">
            <span aria-hidden="true" class="grid size-6 place-items-center rounded-full bg-brand">
              <svg viewBox="0 0 12 12" class="size-3 fill-none stroke-white stroke-[1.8]" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.2 2.3 2.3 4.7-5" /></svg>
            </span>
            {name}
          </li>
        ))}
      </ul>
    </div>

    <p data-reveal class="mt-12 mb-5 text-[13px] font-medium tracking-[0.14em] text-soft uppercase">Add-on modules</p>
    <ul class="grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-4">
      {addOns.map(([name, body, icon]) => (
        <li data-reveal class="group/mod border-r border-b border-line p-6 transition-colors duration-300 hover:bg-pill">
          <span class="grid size-12 place-items-center rounded-xl bg-brand-50 text-brand transition-[background-color,color,rotate] duration-400 ease-out-expo group-hover/mod:-rotate-6 group-hover/mod:bg-brand group-hover/mod:text-white">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-6 fill-none stroke-current stroke-[1.3]" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
          </span>
          <h3 class="mt-8 text-lg font-bold tracking-tight">{name}</h3>
          <p class="mt-1.5 text-[15px] text-soft">{body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
