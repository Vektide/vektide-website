---
// Core + add-ons. The core sits in a grey panel with lime checks (included); the add-ons are a
// ruled list with outlined plus marks (optional). The marks carry the difference.
const core = [
  ['Consultation desk', 'Register visits, issue tokens, collect fees and refunds.'],
  ['Patients', 'Directory and full visit history.'],
  ['Doctors and services', 'Your doctors, fees and service list.'],
  ['Staff roles', 'Separate access for admin, reception and lab.'],
  ['Your clinic’s name and logo', 'On screens, slips and receipts.'],
];

const addOns = [
  ['Laboratory and diagnostics', 'Lab, X-ray, ultrasound and ECG: orders, sample queue, results and lab billing.'],
  ['Appointments', 'Book ahead, then check patients in with one click.'],
  ['Doctor payouts', 'Calculate what each doctor earned and record settlements.'],
  ['Staff and payroll', 'Staff directory, monthly salary slips and payroll.'],
  ['Staff schedules', 'Weekly shifts and duty rotas.'],
  ['Clinic expenses', 'Rent, electricity, supplies and other day-to-day spending.'],
  ['Doctor schedules', 'Weekly sitting hours, leaves and delays.'],
  ['Doctor presence', 'Show reception which doctors are in the clinic right now.'],
];
---

<section class="mx-auto max-w-[1280px] px-4 pb-24 sm:px-8 md:pb-36">
  <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end md:gap-16">
    <h2 class="text-5xl leading-[0.95] font-bold tracking-tighter text-balance sm:text-6xl">Start with the core. Add what you need.</h2>
    <p class="max-w-md text-lg text-soft">
      Every clinic gets the core system. Add modules now or later, and pay only for the ones you use. A new module goes
      live the same day, with no reinstall.
    </p>
  </div>

  <div class="mt-14 grid gap-10 md:mt-20 md:grid-cols-[1fr_1.6fr] md:gap-16">
    <div class="self-start rounded-[32px] bg-pill p-8 sm:p-10">
      <h3 class="text-2xl font-bold tracking-tight">Included for every clinic</h3>
      <ul class="mt-8 space-y-6">
        {core.map(([name, body]) => (
          <li class="grid grid-cols-[auto_1fr] gap-4">
            <span aria-hidden="true" class="mt-0.5 grid size-6 place-items-center rounded-full bg-lime">
              <svg viewBox="0 0 12 12" class="size-3 fill-none stroke-ink stroke-[1.8]" stroke-linecap="round" stroke-linejoin="round"><path d="m2.5 6.2 2.3 2.3 4.7-5" /></svg>
            </span>
            <div>
              <p class="font-medium">{name}</p>
              <p class="mt-0.5 text-[15px] text-soft">{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-2xl font-bold tracking-tight">Add-on modules</h3>
      <ul class="mt-6 grid gap-x-10 sm:grid-cols-2">
        {addOns.map(([name, body]) => (
          <li class="grid grid-cols-[auto_1fr] gap-4 border-t border-line py-5">
            <span aria-hidden="true" class="relative mt-0.5 grid size-6 place-items-center rounded-full ring-1 ring-line ring-inset">
              <span class="absolute h-[1.5px] w-2.5 rounded bg-ink"></span>
              <span class="absolute h-2.5 w-[1.5px] rounded bg-ink"></span>
            </span>
            <div>
              <p class="font-medium">{name}</p>
              <p class="mt-0.5 text-[15px] text-soft">{body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
